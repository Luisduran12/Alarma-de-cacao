# Variables de entorno del servidor (se configuran en Vercel: Project Settings > Environment Variables).
# Este archivo solo lista los NOMBRES. No escriba aquí valores reales ni suba un .env a GitHub.

# --- Obligatorias ---
# Clave de la API de Anthropic. La lee directamente el SDK desde el entorno.
ANTHROPIC_API_KEY=
# Secreto (16 o más caracteres, al azar) para anonimizar IDs e IPs antes de contarlos.
ID_PEPPER=
# Almacén de contadores y caché (Upstash Redis desde el Marketplace de Vercel). Sirve cualquiera de los dos pares:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Obligatoria solo para /lugar ---
# Contacto que se incluye en el User-Agent de Nominatim (la política de OSM lo exige).
NOMINATIM_CONTACTO=

# --- Opcionales (ver los valores por defecto en src/config.ts) ---
# PRESUPUESTO_DIARIO_USD=5
# LIMITE_CHAT_DIA=30
# LIMITE_FOTO_DIA=10
# LIMITE_LUGAR_DIA=100
# LIMITE_IP_HORA=300
# MODELO_CHAT=claude-haiku-5-5
# MODELO_FOTO=claude-sonnet-5-5
# BLOQUEO_TOTAL=1   # interruptor de emergencia: rechaza todo lo que cuesta dinero

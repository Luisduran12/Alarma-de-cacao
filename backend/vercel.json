{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.ts": { "maxDuration": 30 },
    "api/analizar-foto.ts": { "maxDuration": 60 },
    "api/lugar.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/chat", "destination": "/api/chat" },
    { "source": "/analizar-foto", "destination": "/api/analizar-foto" },
    { "source": "/lugar", "destination": "/api/lugar" }
  ]
}
